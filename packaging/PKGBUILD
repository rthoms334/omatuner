# Maintainer: Robert Thomson
# Arch / Omarchy package for Tuner (repository and package "omatuner"; the app, its command
# `tuner`, desktop entry, icon and app id stay "tuner"), built from this checkout (no download of
# the app itself):
#   cd packaging && makepkg -si
# The release workflow (.github/workflows/release.yml) builds this same PKGBUILD for x86_64 and
# aarch64 and attaches the packages to the GitHub Release.
# Cargo's build output goes to packaging/src/target, so makepkg's RUSTFLAGS don't invalidate the
# developer's own target/ directory.
pkgname=omatuner
pkgver=0.2.4
pkgrel=1
pkgdesc="Keyboard-first IPTV player for Omarchy (M3U, Xtream, XMLTV, catch-up)"
arch=('x86_64' 'aarch64')
url="https://github.com/rthoms334/omatuner"
license=('GPL-3.0-or-later')
# Linked: libmpv (client API >= 2.5, mpv >= 0.38) and liblzma (xz). Loaded at runtime:
# libwayland-client, libxkbcommon, libEGL/libGL (mesa). fontconfig for fc-match/fc-list; the
# UI font and its icon glyphs are JetBrains Mono Nerd Font (Omarchy's monospace). MPRIS,
# notifications and the portal file pickers talk to the session bus (dbus).
depends=('mpv>=1:0.38' 'xz' 'fontconfig' 'ttf-jetbrains-mono-nerd' 'wayland' 'libxkbcommon'
         'mesa' 'dbus' 'gcc-libs' 'glibc')
makedepends=('cargo')
optdepends=('hyprland: window rules from /usr/share/tuner/hypr, raising the window'
            'xdg-desktop-portal-gtk: file pickers (add a playlist file, backup, log export)'
            'noto-fonts-cjk: CJK channel and programme names'
            'noto-fonts: Arabic, Hebrew and Indic fallbacks')
# Cargo's release profile already strips debuginfo and keeps the symbols for coredump backtraces
# (Cargo.toml), so makepkg must not strip again, and a split -debug package would be empty.
options=('!lto' '!debug' '!strip')
source=()
# Prints how to connect an AI agent (after install, and on the upgrade that brought it); no more.
install=omatuner.install
_srcdir="$(realpath "$startdir/..")"

# aws-lc-sys (rustls' crypto) compiles jitterentropy with -O0 and refuses any optimisation, but
# cc-rs appends makepkg's CFLAGS (-O2) after it. Drop the -O flags: cc-rs passes the crate
# profile's own -O level to every C dependency anyway.
_cflags() {
  local _f _kept=()
  for _f in $CFLAGS; do [[ $_f == -O* ]] || _kept+=("$_f"); done
  export CFLAGS="${_kept[*]}"
}

prepare() {
  cd "$_srcdir"
  if [[ ! -f Cargo.toml ]]; then
    error "PKGBUILD must stay in packaging/ of the Tuner checkout"
    return 1
  fi
  local _version
  _version="$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)"
  # A pre-release build (release.yml) appends its tag's suffix, e.g. 0.1.0rc4 for v0.1.0-rc4,
  # which pacman orders before 0.1.0.
  if [[ $pkgver != "$_version" && $pkgver != "$_version"[a-z]* ]]; then
    error "pkgver ($pkgver) does not match Cargo.toml ($_version)"
    return 1
  fi
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_srcdir"
  _cflags
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR="$srcdir/target"
  # Generated sources (e.g. glutin_egl_sys's bindings) live under $srcdir/target; keep the build
  # directory out of the binary's panic locations and line tables.
  export RUSTFLAGS="${RUSTFLAGS:+$RUSTFLAGS }--remap-path-prefix=$srcdir=/usr/src/debug/$pkgname"
  cargo build --frozen --release
}

check() {
  # A smoke test of the built binary (it loads libmpv and parses the command line). The test
  # suite is the developer gate (`cargo test`, see README "Development"): built here it would be
  # a second thin-LTO release binary, which took over an hour on a 16 GB machine.
  "$srcdir/target/release/tuner" --version
}

package() {
  cd "$_srcdir"
  install -Dm755 "$srcdir/target/release/tuner" "$pkgdir/usr/bin/tuner"
  install -Dm644 packaging/tuner.desktop "$pkgdir/usr/share/applications/tuner.desktop"
  install -Dm644 packaging/icons/tuner.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/tuner.svg"
  # Opt-in snippets (nothing is written to the user's config): see README "Omarchy integration".
  install -Dm644 packaging/hypr/tuner.lua "$pkgdir/usr/share/tuner/hypr/tuner.lua"
  install -Dm644 packaging/omarchy/omarchy-menu.jsonc "$pkgdir/usr/share/tuner/omarchy/omarchy-menu.jsonc"
  # The Claude Code plugin (its marketplace, the `tuner mcp` server entry, the skills): installed
  # here only. Tuner adds it to Claude Code when the user asks (its first-start card, Settings ▸ AI
  # agents, or `tuner claude-setup`). Nothing is written to the home directory.
  install -Dm644 .claude-plugin/marketplace.json "$pkgdir/usr/share/tuner/claude/.claude-plugin/marketplace.json"
  local _f
  while IFS= read -r -d '' _f; do
    install -Dm644 "$_f" "$pkgdir/usr/share/tuner/claude/$_f"
  done < <(find plugins/omatuner -type f -print0)
  install -Dm644 -t "$pkgdir/usr/share/doc/tuner" README.md docs/DESIGN.md docs/MANUAL_CHECKLIST.md
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
