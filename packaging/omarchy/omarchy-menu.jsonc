{
  // Tuner entries for the Omarchy menu. Merge into
  // ~/.config/omarchy/extensions/omarchy-menu.jsonc (the menu watches that file).
  "tv": {"icon":"󰔂","label":"TV","description":"Tuner IPTV player"},
  "tv.open": {"icon":"󰔂","label":"Open Tuner","action":"omarchy-launch-or-focus tuner 'uwsm-app -- tuner'"},
  "tv.live": {"icon":"󰐊","label":"Live TV","action":"uwsm-app -- tuner --view live"},
  "tv.guide": {"icon":"󰃰","label":"TV Guide","action":"uwsm-app -- tuner --view guide"},
  "tv.search": {"icon":"󰍉","label":"Search TV","action":"uwsm-app -- tuner --view search"},
  "tv.settings": {"icon":"󰒓","label":"Playlists & settings","action":"uwsm-app -- tuner --view settings"},
}
